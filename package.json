{
  "name": "opencode-subagents",
  "version": "2.0.0",
  "description": "Autonomous subagents system for OpenCode v2 - create, invoke, and cleanup specialized AI subagents on-demand",
  "type": "module",
  "main": "dist/define-subagent.js",
  "bin": {
    "define-subagent": "./dist/define-subagent.js",
    "opencode-subagents-install": "./dist/install.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/define-subagent.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "install:local": "node dist/install.js",
    "doctor": "node dist/define-subagent.js --doctor"
  },
  "keywords": [
    "opencode",
    "subagents",
    "ai",
    "autonomous",
    "cli",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/",
    "agents/",
    "instructions/",
    "skills/",
    "scripts/",
    "opencode.example.jsonc",
    "README.md",
    "LICENSE",
    "TROUBLESHOOTING.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  }
}
